{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-lfg",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-lfg",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
