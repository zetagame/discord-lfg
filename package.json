{
  "name": "discord-lfg",
  "version": "1.0.0",
  "description": "A minimal Discord LFG bot for Cloudflare Workers",
  "private": true,
  "scripts": {
    "check": "tsc",
    "typecheck": "tsc",
    "deploy": "npm run migrations:remote && wrangler deploy",
    "dev": "wrangler dev",
    "test": "tsx --test test/*.test.ts",
    "migrations": "wrangler d1 migrations apply discord-lfg --local",
    "migrations:remote": "wrangler d1 migrations apply DB --remote",
    "register-commands": "node scripts/register-commands.mjs"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/zetagame/discord-lfg"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
